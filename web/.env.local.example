# Where the CyberShop API Worker lives.
# Local: http://127.0.0.1:8787  ·  Production: https://<worker>.<account>.workers.dev
WORKER_URL=http://127.0.0.1:8787

# Must match the Worker's INTERNAL_SECRET (see worker/.dev.vars.example).
WORKER_INTERNAL_SECRET=

# Public origin of this site (used for canonical/OG URLs).
# Local: http://localhost:3000  ·  Production: https://cybershop.ng
SITE_URL=http://localhost:3000
