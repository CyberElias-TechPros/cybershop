{
  "name": "cybershop-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy --env production",
    "db:migrate": "wrangler d1 migrations apply cybershop --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:production": "wrangler d1 migrations apply cybershop --remote --env production"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.14.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
