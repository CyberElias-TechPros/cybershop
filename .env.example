# --- Database -------------------------------------------------------------
# Dev: leave unset and the app uses embedded PGlite at ./.data/pgdata (zero setup).
# Staging/Prod (Neon / Vercel Postgres / any Postgres):
# DATABASE_URL=postgres://user:pass@host:5432/cybershop

# --- App ------------------------------------------------------------------
# Public origin used to build absolute URLs for og:url / wa.me product links.
PUBLIC_APP_URL=http://localhost:3000

# --- Media service --------------------------------------------------------
# local | gateway. `local` writes to .data/media (dev). `gateway` calls your
# shared-host PHP media gateway (docs/media-gateway).
MEDIA_DRIVER=local
# e.g. https://media.yourdomain.com
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/__media
# Shared secret between the app and the gateway (HMAC signing key).
MEDIA_GATEWAY_URL=
MEDIA_GATEWAY_SECRET=change-me-to-a-long-random-string

# --- Paystack (Phase 2; absent = Paystack paths hidden) ------------------
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_PUBLIC_KEY=sk_test_xxx
# PAYSTACK_WEBHOOK_SECRET=xxx

# --- Jobs ----------------------------------------------------------------
# Secret used to authorize the cron endpoint (Vercel Cron sends it as a header).
CRON_SECRET=change-me
